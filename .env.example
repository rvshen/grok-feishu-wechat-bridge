# ========================================================
# Grok Feishu & WeChat Bridge Environment Configuration
# ========================================================

# --- Feishu (Lark) Channel Configuration ---
# Feishu Open Platform Application Credentials (Self-built App)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- WeChat Channel Configuration (Dual-Channel Bridge) ---
# Enterprise WeChat / WeChat Gateway Credentials
WECHAT_CORP_ID=
WECHAT_CORP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=

# --- xAI Grok Bot Routine Webhook Wake ---
# Webhook routine URL and authentication token configured in Grok Bot
GROK_WAKE_URL=https://api.x.ai/v1/routines/webhook/xxxxxx
GROK_WAKE_KEY=your_routine_webhook_key_here

# --- Access Control & Bridge Home (Optional) ---
# Comma-separated list of allowed user IDs (e.g. ou_xxx for Feishu open_id)
ALLOW_USERS=
# Directory for storing bridge runtime config, inbox, and logs (default: ~/.grok-bridge)
GROK_BRIDGE_HOME=
